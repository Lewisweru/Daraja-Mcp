# "sandbox" or "production"
DARAJA_ENV=sandbox

# From your Daraja app (developer.safaricom.co.ke > My Apps)
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=

# Your till/paybill number and its STK Push passkey
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
# CustomerBuyGoodsOnline for a Till, CustomerPayBillOnline for a Paybill
DARAJA_STK_TRANSACTION_TYPE=CustomerBuyGoodsOnline

# Org-level credentials, needed only for b2c_payment / b2b_payment /
# transaction_status / account_balance / reversal
DARAJA_INITIATOR_NAME=
DARAJA_INITIATOR_PASSWORD=
DARAJA_CERT_PATH=certs/sandbox.cer

# Public base URL of THIS service once deployed on Render, e.g.
# https://daraja-mcp.onrender.com  (no trailing slash)
CALLBACK_BASE_URL=http://localhost:3000

# Safety caps for b2c_payment / b2b_payment / reversal (KES)
MAX_TRANSACTION_AMOUNT=5000
MAX_DAILY_AMOUNT=20000

# Render sets PORT automatically; only needed for local dev if you want a
# non-default port.
PORT=3000

# Where the SQLite file lives. On Render, point this at your mounted disk,
# e.g. /var/data/daraja.sqlite (see render.yaml).
DB_PATH=data/daraja.sqlite

# Required once deployed publicly: Claude must send this as
# `Authorization: Bearer <token>` to call POST /mcp. Generate with
# `openssl rand -hex 32`. Leave blank only for local dev.
MCP_BEARER_TOKEN=
