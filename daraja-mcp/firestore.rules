rules_version = '2';

// Only the Render backend (via the Admin SDK / service account) touches this
// database. The Admin SDK bypasses these rules entirely, so this file only
// matters if a client-side app (browser/mobile, using the Firebase client
// SDK) ever tries to read or write directly — deny that outright.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
